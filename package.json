{
  "name": "witcher-rilerena",
  "version": "0.1.0-alpha.7",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/witcher/*.test.mjs",
    "build:art": "node tools/witcher/build-art.mjs",
    "build:wounds": "node tools/witcher/build-wounds.mjs",
    "build:packs": "node tools/witcher/build-packs.mjs",
    "validate": "node tools/witcher/validate.mjs",
    "build:release": "node tools/witcher/build-release.mjs",
    "build:magic": "node tools/witcher/build-magic.mjs && node tools/witcher/build-magic-gear.mjs",
    "build:alchemy": "node tools/witcher/build-alchemy.mjs",
    "build:enhancements": "node tools/witcher/build-enhancements.mjs"
  },
  "devDependencies": {
    "@foundryvtt/foundryvtt-cli": "3.0.4",
    "handlebars": "4.7.9",
    "prettier": "3.9.6"
  }
}
