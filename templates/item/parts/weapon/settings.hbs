{{!-- Stuff that affects a single given attack's effects at the other end --}}
<div class="field-list">
    {{> (template "fields/number") label="Accuracy" edit="system.accuracy"}}
    {{> (template "fields/string") label="Damage" edit="system.damage"}}
    <div class="field">
        <label for="weapon-ap-{{item.id}}">{{CPLocal "AP"}}</label>
        <select id="weapon-ap-{{item.id}}" name="system.ap">
            <option value="unknown" {{#unless (equals system.ap true)}}{{#unless (equals system.ap false)}}selected{{/unless}}{{/unless}}>{{CPLocal "CatalogUnknown"}}</option>
            <option value="false" {{#if (equals system.ap false)}}selected{{/if}}>{{CPLocal "CatalogNormalAmmo"}}</option>
            <option value="true" {{#if (equals system.ap true)}}selected{{/if}}>{{CPLocal "AP"}}</option>
        </select>
    </div>
    {{#if (equals system.weaponType "Melee")}}
    <div class="field">
        <label for="melee-damage-type-{{item.id}}">{{CPLocal "CatalogMeleeDamageType"}}</label>
        <select id="melee-damage-type-{{item.id}}" name="system.meleeDamageType">
            <option value="">—</option>
            <option value="edged" {{#if (equals system.meleeDamageType "edged")}}selected{{/if}}>{{CPLocal "CatalogEdged"}}</option>
            <option value="blunt" {{#if (equals system.meleeDamageType "blunt")}}selected{{/if}}>{{CPLocal "CatalogBlunt"}}</option>
        </select>
    </div>
    {{/if}}
    {{> (template "fields/number") label="Range" edit="system.range"}}

    {{!-- Damage bands consumed by the shotgun resolver. --}}
    <details class="field span-two-cells">
        <summary>{{CPLocal "Advanced"}}</summary>
        <div class="field-list">
            {{> (template "fields/string") label=(concat (CPLocal "DamageShort") " (" (CPLocal "PointBlank") ")") edit="system.rangeDamages.pointBlank"}}
            {{> (template "fields/string") label=(concat (CPLocal "DamageShort") " (" (CPLocal "Close") ")") edit="system.rangeDamages.close"}}
            {{> (template "fields/string") label=(concat (CPLocal "DamageShort") " (" (CPLocal "Medium") ")") edit="system.rangeDamages.medium"}}
            {{> (template "fields/string") label=(concat (CPLocal "DamageShort") " (" (CPLocal "Long") ")") edit="system.rangeDamages.far"}}
        </div>
    </details>
</div>

{{!-- Stuff that affects how many shots the weapon can pump out --}}
<div class="field-list">
    {{> (template "fields/number") label="ShotsLeft" edit="system.shotsLeft"}}
    {{> (template "fields/number") label="Shots" edit="system.shots"}}
    {{> (template "fields/number") label="RoF" edit="system.rof"}}
    {{> (template "fields/select") label="Reliability" edit="system.reliability" choices=reliabilities allowBlank=true}}
    <div class="field span-two-cells">
        <label for="weapon-fire-modes-{{item.id}}">{{CPLocal "CatalogFireModes"}}</label>
        <select id="weapon-fire-modes-{{item.id}}" name="system.fireModes" multiple>
            {{#each fireModeChoices as |mode|}}
            <option value="{{mode.key}}" {{#if mode.selected}}selected{{/if}}>{{mode.label}}</option>
            {{/each}}
        </select>
    </div>
</div>

{{!-- What kind of thing is this weapon, how it's used --}}
<div class="field-list">
    {{!-- When changing weapon type, the weapon's attack type will not update correspondingly until the sheet is closed --}}
    {{> (template "fields/select") label="WeaponType" edit="system.weaponType" choices=weaponTypes}}
    {{> (template "fields/select") label="AttackType" edit="system.attackType" choices=attackTypes allowBlank=true}}
    {{!-- Custom, as all the translate keys start with Skill, but they don't in the character --}}
    {{!-- This might not need to be custom anymore, as regular selects can deal with choices that supply their own translateKeys --}}
    <div class="field">
        <label for="system.attackSkill">{{CPLocal "AttackSkill"}}</label>
        <div class="flex-pad"></div>
        {{#if (equals system.weaponType 'Exotic')}}
            {{!-- This will be populated by actor skills if it's held by an actor, but an input is at least editable --}}
            <datalist id="possibleSkills">
                {{#each attackSkills as |skill|}}
                <option value="{{skill}}">{{skill}}</option>
                {{/each}}
            </datalist>
            <input type="text" list="possibleSkills" placeholder="Choose Skill" name="system.attackSkill" value="{{system.attackSkill}}"/>
        {{else}}
            <select name="system.attackSkill">
                <option value="">—</option>
                {{#each attackSkillChoices as |skill|}}
                <option value="{{skill.key}}" {{#if (equals ../selectedAttackSkill skill.key)}}selected{{/if}}>{{skill.label}}</option>
                {{/each}}
            </select>
        {{/if}}
    </div>
    {{> (template "fields/select") label="Concealability" edit="system.concealability" choices=concealabilities allowBlank=true}}
</div>

{{!-- Market stuff --}}
<div class="field-list">
    {{> (template "fields/select") label="Availability" edit="system.availability" choices=availabilities allowBlank=true}}
    {{!-- Ammo counts as market, as it doesn't affect things mechanically currently --}}
    {{> (template "fields/string") label="AmmoType" edit="system.ammoType"}}
</div>
