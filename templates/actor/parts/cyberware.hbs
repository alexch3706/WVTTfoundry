<div class="field-list no-wrap">
    <div class="field">
        <label for="totalCyberCost">{{CPLocal "TotalEBVal"}}</label>
        <input name="totalCyberCost" type="number" value="{{gear.cyberCost}}" readonly>
    </div>
    <div class="field">
        <label for="system.stats.emp.humanity.loss">{{CPLocal "HumanityLoss"}}</label>
        <input class="not-editable" name="system.stats.emp.humanity.loss" type="number" value="{{system.stats.emp.humanity.loss}}" readonly>
    </div>
</div>

{{#if (equals gear.cyberware.length 0)}}
    <div class="inactive">{{CPLocal "DragItemsPrompt"}}</div>
{{/if}}
<div class="field-list one-col cyberware-list">
    {{#each gear.cyberware as |cyber|}}
        <div class="field gear item-edit full-width" data-item-id="{{cyber.id}}">
            <div class="field-image" style="background-image: url({{cyber.img}})" data-item-id="{{cyber.id}}"></div>
            <label>{{cyber.name}}</label>
            <span class="flex-pad"></span>
            {{#with cyber.system}}
                <span>{{CPLocal "HumanityLossAbbrev"}}: {{humanityLoss}}</span>
                {{#if cyberwareType}}
                <span>
                    <p class="inactive">{{cyberwareType}}
                        {{~#if cyberwareSubtype~}}
                        ({{cyberwareSubtype}})
                        {{~/if}}</p>
                </span>
                {{/if}}
            {{/with}}
            {{#if (equals cyber.system.automation.status "manual")}}
            <span class="inactive" title="{{#each cyber.system.automation.reasons}}{{this}} {{/each}}">{{CPLocal "CatalogManual"}}</span>
            {{/if}}
            {{#if cyber.armorStatus.isArmor}}
                <span title="{{CPLocal "ArmorCyberwareStatus"}}" class="inactive">
                    {{#if cyber.armorStatus.locations}}
                    {{#each cyber.armorStatus.locations as |segment|}}
                    <span>{{shortCPLocal segment.location}} {{segment.currentStoppingPower}}/{{segment.baseStoppingPower}}{{#unless @last}} · {{/unless}}</span>
                    {{/each}}
                    {{else}}
                    {{CPLocal "SPFull"}} {{cyber.armorStatus.currentStoppingPower}}/{{cyber.armorStatus.baseStoppingPower}}
                    {{/if}}
                </span>
                {{#if cyber.armorStatus.repairable}}
                    <button type="button" class="repair-cyberware-armor" data-item-id="{{cyber.id}}" title="{{CPLocal "RepairArmor"}}">{{CPLocal "Repair"}}</button>
                {{/if}}
            {{/if}}
            <span class="item-delete" data-item-id="{{cyber.id}}">X</span>
        </div>
    {{/each}}
</div>
