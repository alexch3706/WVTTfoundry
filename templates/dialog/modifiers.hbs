{{#*inline "attackModifierGroup"}}
    <div class="field-list">
        {{#each group}}
            {{#with @root.defaultValues}}
                {{>(template ../fieldPath) label=../localKey edit=../dataPath choices=../choices noTranslateChoices=../noTranslateChoices allowBlank=../allowBlank readOnly=../readOnly}}
            {{/with}}
        {{/each}}
    </div>
{{/inline}}

<form class="cyberpunk weapon-modifiers">
    <header class="attack-summary">
        {{#if weapon.name}}<h2>{{weapon.name}}</h2>{{/if}}
        <p class="attack-target-summary">
            <strong>{{CPLocal "Targets"}}:</strong>
            {{#if (hasElements targetTokens)}}
                {{#each targetTokens}}{{#unless @first}}, {{/unless}}{{this.name}}{{/each}}
            {{else}}
                {{CPLocal "AttackNoTargets"}}
            {{/if}}
        </p>
    </header>

    {{#if templateTargetingAvailable}}
        {{#with defaultValues}}
            {{>(template "fields/select") label="AttackTargeting" edit="targetingMode" choices=@root.targetingModes}}
        {{/with}}
        <p class="notes attack-template-range-hint" hidden>{{CPLocal "AttackTemplateRangeHint"}}</p>
    {{/if}}

    {{#each primaryModifierGroups as |group|}}
        {{> attackModifierGroup group=group}}
    {{/each}}

    {{#if manualAttackDieEnabled}}
        <div class="field attack-manual-die">
            <label for="weapon-modifier-manual-die">{{CPLocal "AttackDieEntryManualLabel"}}</label>
            <input id="weapon-modifier-manual-die" type="text" name="manualAttackDie"
                value="{{manualAttackDie}}" placeholder="7 / 10,6" aria-describedby="weapon-modifier-manual-hint" />
        </div>
        <p id="weapon-modifier-manual-hint" class="notes">{{CPLocal "AttackManualDieOptionalHint"}}</p>
    {{/if}}

    {{#if (hasElements advancedModifierGroups)}}
        <details class="attack-advanced" {{#if advancedExpanded}}open{{/if}}>
            <summary>{{CPLocal "Advanced"}}</summary>
            {{#each advancedModifierGroups as |group|}}
                {{> attackModifierGroup group=group}}
            {{/each}}
        </details>
    {{/if}}

    <button type="submit" name="submit" class="fire" value="1" autofocus>{{CPLocal "AttackRollAction"}}</button>
</form>
