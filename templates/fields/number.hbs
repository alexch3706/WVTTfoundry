<div class="field">
    <label for="{{#if @root.actor}}{{@root.actor.id}}-{{/if}}{{#if @root.item}}{{@root.item.id}}-{{/if}}{{edit}}">{{CPLocal label}}</label>
    <span class="flex-pad"></span>
    <input {{#if readOnly}}readonly{{/if}} class="number nogrow nowidth"
        id="{{#if @root.actor}}{{@root.actor.id}}-{{/if}}{{#if @root.item}}{{@root.item.id}}-{{/if}}{{edit}}" name="{{edit}}"
        type="number" value="{{deepLookup . edit}}"/>
</div>
